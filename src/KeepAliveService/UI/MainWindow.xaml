<ui:FluentWindow x:Class="KeepAliveService.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Windows Keep Alive"
    Width="820" Height="620"
    MinWidth="700" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="#FAFAFA"
    Foreground="#1A1A1A">

    <Grid TextElement.FontWeight="Medium">
        <Grid.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#888888" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#1A1A1A" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                     FontSize="14" FontWeight="SemiBold"
                     ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/assets/app.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" x:Name="MainTabControl" Margin="12,0,12,8"
                    FontSize="14"
                    SelectionChanged="MainTabControl_SelectionChanged">

            <!-- Setup Tab -->
            <TabItem Header="Setup">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Quick Setup" Margin="0,0,0,12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Configure keep-alive, auto-login, update policy, network, and service with one click."
                                       Margin="0,0,0,12" Opacity="0.6" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:"
                                           VerticalAlignment="Center" Margin="0,0,0,8" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="UsernameBox"
                                         Margin="0,0,0,8"
                                         ToolTip="Windows sign-in username (for Microsoft accounts, use your email)."
                                         TextChanged="Credential_Changed" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Account:"
                                           VerticalAlignment="Center" Margin="0,0,0,8" />
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="AccountTypeBox"
                                              ToolTip="Select how you sign into Windows."
                                              SelectionChanged="AccountType_SelectionChanged" />
                                    <TextBlock Grid.Column="1" Text="Domain:"
                                               VerticalAlignment="Center" Margin="12,0" />
                                    <TextBox Grid.Column="2" x:Name="DomainBox"
                                             ToolTip="Domain or machine name used for sign-in."
                                             TextChanged="Credential_Changed" />
                                </Grid>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:"
                                           VerticalAlignment="Center" Margin="0,0,0,8" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <PasswordBox x:Name="PasswordHidden"
                                                     ToolTip="Windows account password (not PIN)."
                                                     PasswordChanged="Password_Changed" />
                                        <TextBox x:Name="PasswordVisible" Visibility="Collapsed"
                                                 ToolTip="Windows account password (not PIN)."
                                                 TextChanged="Credential_Changed" />
                                    </Grid>
                                    <CheckBox Grid.Column="1" Content="Show" x:Name="ShowPasswordCheck"
                                              VerticalAlignment="Center" Margin="12,0,0,0"
                                              ToolTip="Show or hide the password text."
                                              Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
                                </Grid>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:Button Content="Run Setup" x:Name="RunSetupButton"
                                           Appearance="Primary" Margin="0,0,8,0"
                                           ToolTip="Configures auto-login, power settings, Windows Update policy, and installs the KeepAlive service."
                                           Click="RunSetup_Click" />
                                <ui:Button Content="Test Credentials" x:Name="TestCredentialsButton"
                                           Margin="0,0,8,0"
                                           ToolTip="Validates your credentials without making any changes."
                                           Click="TestCredentials_Click" />
                                <ui:Button Content="Update Password" x:Name="UpdatePasswordButton"
                                           Margin="0,0,8,0"
                                           ToolTip="Changes only the auto-login password (leaves all other settings intact)."
                                           Click="UpdatePassword_Click" />
                                <ui:Button Content="Restore" x:Name="RestoreButton"
                                           Appearance="Caution"
                                           ToolTip="Restores all Windows settings to their original values and removes the service. The program stays installed for future use."
                                           Click="Restore_Click" />
                                <ui:Button Content="Uninstall" x:Name="UninstallButton"
                                           Appearance="Danger" Margin="8,0,0,0"
                                           ToolTip="Restores all settings AND removes the program completely from this machine."
                                           Click="Uninstall_Click" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Output" Padding="4">
                        <RichTextBox x:Name="OutputBox" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="10.5pt"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" IsDocumentEnabled="True">
                            <RichTextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Selected" Click="CopySelected_Click" />
                                    <MenuItem Header="Copy All" Click="CopyAll_Click" />
                                    <MenuItem Header="Select All" Click="SelectAll_Click" />
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Status Tab -->
            <TabItem Header="Status">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="ServiceStatusLabel" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock x:Name="ComplianceLabel" FontSize="14"
                                   Text="Compliance: not checked" Margin="0,0,0,8" />
                        <TextBlock x:Name="LastCheckLabel" Text="Last check: never"
                                   Opacity="0.6" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Run Check" x:Name="RunCheckButton"
                                       Margin="0,0,8,0"
                                       ToolTip="Verifies all settings are correctly applied."
                                       Click="RunCheck_Click" />
                            <ui:Button Content="Start Service" x:Name="StartServiceButton"
                                       Margin="0,0,8,0"
                                       ToolTip="Start the KeepAlive Windows service."
                                       Click="StartService_Click" />
                            <ui:Button Content="Stop Service" x:Name="StopServiceButton"
                                       Margin="0,0,8,0"
                                       ToolTip="Stop the KeepAlive Windows service."
                                       Click="StopService_Click" />
                            <ui:Button Content="Restart Service" x:Name="RestartServiceButton"
                                       ToolTip="Restart the KeepAlive Windows service."
                                       Click="RestartService_Click" />
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Check Results" Padding="4">
                        <TextBox x:Name="StatusOutputBox" IsReadOnly="True"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="10pt"
                                 BorderThickness="0" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Updates Tab -->
            <TabItem Header="Updates">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="CurrentVersionLabel" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" x:Name="LatestVersionLabel" Text="Latest: unknown"
                               FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" x:Name="LastUpdateCheckLabel" Opacity="0.6" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="3" Text="Release notes:" Margin="0,0,0,4" />

                    <TextBox Grid.Row="4" x:Name="ReleaseNotesBox" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="10pt"
                             BorderThickness="0" />

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Check Now" x:Name="CheckUpdatesButton"
                                   Margin="0,0,8,0"
                                   ToolTip="Check GitHub for a newer version."
                                   Click="CheckUpdates_Click" />
                        <ui:Button Content="Update Now" x:Name="UpdateNowButton"
                                   Appearance="Primary" IsEnabled="False"
                                   ToolTip="Download and install the latest version."
                                   Click="UpdateNow_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Logs Tab -->
            <TabItem Header="Logs">
                <TextBox x:Name="LogViewerBox" IsReadOnly="True"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="10pt"
                         BorderThickness="0" Margin="4" />
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Padding="12,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionStatus" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock Text="|" Opacity="0.3" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock x:Name="AdminStatus" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock Text="|" Opacity="0.3" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock x:Name="ServiceStatusStrip" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock Text="|" Opacity="0.3" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock x:Name="UpdateStatusStrip" Text="Update: idle" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Copy" FontSize="12" Padding="4,0" Margin="0,0,8,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Click="CopyOutput_Click" />
                    <Button Content="Clear" FontSize="12" Padding="4,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Click="ClearOutput_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
